<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>a39383f4-d31c-49a0-adea-c1e531f26887</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.2" />
    <!-- Lifts the 9.0.11 copy that Microsoft.Data.SqlClient brings in, which NuGet audit flags as vulnerable. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- The exported test-set seed (data/seed) is the source of the wallet's rows; copy it to the output so
       migrate, seed-hash, the running app and the tests all read the same bytes as the repository. -->
  <ItemGroup>
    <Content Include="..\..\data\seed\*.json" Link="seed\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
