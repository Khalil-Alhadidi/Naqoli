@implements IDisposable
@using System.Globalization
@using Agent.Core.Parsing
@using Agent.Core.Wallet
@inject IServiceScopeFactory Scopes
@inject IOptionsMonitor<AgentOptions> Options
@inject IOptions<ModelOptions> Model
@inject RuntimeSettings Runtime
@inject KillSwitch Kill
@inject IOptions<ConsoleOptions> ConsoleSettings
@using Agent.Core.Audit

@* D8: the agent's limits are edited here and apply to the next action, without a restart. A saved value lives in memory
   only (RuntimeSettings); the other rows are read only. No key (wallet or Anthropic) is ever shown. *@
<MudPaper Class="pa-3" Elevation="1">
    <MudText Typo="Typo.h6">Settings</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">A saved value applies to the next action and is forgotten when the console restarts.</MudText>
    <MudText Typo="Typo.body2" Class="mb-2" data-testid="settings-fault-pointer">The fault switch (wallet faults, a model fault, an external debit) is in the Faults panel beside the live trace.</MudText>

    <MudText Typo="Typo.subtitle1" Class="mt-2">Agent</MudText>
    @* Khalil, 15 Oct 2026: while on, no card is issued, Confirm and check-again are refused; off at every start. *@
    <MudSwitch T="bool" Value="@Kill.IsOn" ValueChanged="SetKillSwitchAsync" Color="Color.Error"
               Label="Kill switch (nothing moves while on)"
               data-testid="kill-switch" data-on="@(Kill.IsOn ? "true" : "false")" />
    @if (killSwitchError is not null)
    {
        <MudText data-testid="setting-error" data-name="KillSwitch" Typo="Typo.caption" Color="Color.Error">@killSwitchError</MudText>
    }
    <MudSimpleTable Dense="true">
        <tbody>
            @{ var current = Options.CurrentValue; }
            @foreach (var (name, read) in Editable)
            {
                var key = Key(name);
                <tr data-testid="setting-row" data-name="@name">
                    <td>@name</td>
                    <td data-testid="setting-value" data-name="@name">@Number(read(current))</td>
                    <td>
                        <input data-testid="setting-input" data-name="@name" type="text" inputmode="numeric" aria-label="@name"
                               value="@Draft(name)" @oninput="e => drafts[name] = e.Value?.ToString() ?? string.Empty" />
                        <MudButton data-testid="setting-save" data-name="@name" Size="Size.Small" Variant="Variant.Outlined"
                                   OnClick="() => Save(name)">Save</MudButton>
                        @if (Runtime.Overrides.ContainsKey(key))
                        {
                            <MudButton data-testid="setting-reset" data-name="@name" Size="Size.Small" Variant="Variant.Text"
                                       OnClick="() => Reset(name)">Reset</MudButton>
                        }
                        @if (errors.TryGetValue(name, out var error))
                        {
                            <MudText data-testid="setting-error" data-name="@name" Typo="Typo.caption" Color="Color.Error">@error</MudText>
                        }
                    </td>
                </tr>
            }
            @foreach (var (name, value) in ReadOnly(current))
            {
                <tr data-testid="setting-row" data-name="@name"><td>@name</td><td colspan="2">@value</td></tr>
            }
            @* The key itself is never shown: set or not set. *@
            <tr data-testid="setting-row" data-name="Console:WalletAdminKey">
                <td>Console:WalletAdminKey</td>
                <td colspan="2">@(string.IsNullOrEmpty(ConsoleSettings.Value.WalletAdminKey) ? "not set" : "set")</td>
            </tr>
        </tbody>
    </MudSimpleTable>

    <MudText Typo="Typo.subtitle1" Class="mt-4">Wallet (read only)</MudText>
    <MudSimpleTable Dense="true">
        <tbody>
            @switch (wallet)
            {
                case null:
                    <tr><td colspan="2">Reading the wallet's limits…</td></tr>
                    break;
                case WalletResult<WalletSettings>.Ok { Value: var limits }:
                    @foreach (var (name, value) in WalletRows(limits))
                    {
                        <tr data-testid="setting-row" data-name="@name"><td>@name</td><td>@value</td></tr>
                    }
                    break;
                default:
                    <tr data-testid="setting-error" data-name="Wallet"><td colspan="2">@WalletUnavailable(wallet)</td></tr>
                    break;
            }
        </tbody>
    </MudSimpleTable>

    <MudText Typo="Typo.subtitle1" Class="mt-4">Model (read only)</MudText>
    <MudSimpleTable Dense="true">
        <tbody>
            @foreach (var (name, value) in ModelRows())
            {
                <tr data-testid="setting-row" data-name="@name"><td>@name</td><td>@value</td></tr>
            }
        </tbody>
    </MudSimpleTable>
</MudPaper>

@code {
    /// <summary>
    /// The agent limits that can be changed while the console runs, in the order shown: exactly
    /// <see cref="RuntimeSettings.EditableNames"/>, the list the runtime store itself enforces.
    /// </summary>
    private static readonly (string Name, Func<AgentOptions, long> Read)[] Editable =
        [.. RuntimeSettings.EditableNames.Select(name => (name, Reader(name)))];

    private static Func<AgentOptions, long> Reader(string name) => name switch
    {
        nameof(AgentOptions.MinAmountIqd) => o => o.MinAmountIqd,
        nameof(AgentOptions.PerTransactionCapIqd) => o => o.PerTransactionCapIqd,
        nameof(AgentOptions.PerDayCapIqd) => o => o.PerDayCapIqd,
        nameof(AgentOptions.CardTimerSeconds) => o => o.CardTimerSeconds,
        nameof(AgentOptions.MaxProductsInOneQuestion) => o => o.MaxProductsInOneQuestion,
        nameof(AgentOptions.RepeatWarningWindowMinutes) => o => o.RepeatWarningWindowMinutes,
        nameof(AgentOptions.HistoryDays) => o => o.HistoryDays,
        nameof(AgentOptions.MinSubstringWordLength) => o => o.MinSubstringWordLength,
        nameof(AgentOptions.MaxYesNoWords) => o => o.MaxYesNoWords,
        nameof(AgentOptions.LogPageSize) => o => o.LogPageSize,
        nameof(AgentOptions.CheckingRetrySeconds) => o => o.CheckingRetrySeconds,
        nameof(AgentOptions.MaxAliasLength) => o => o.MaxAliasLength,
        nameof(AgentOptions.MaxMessageChars) => o => o.MaxMessageChars,
        nameof(AgentOptions.MaxRequestsPerMessage) => o => o.MaxRequestsPerMessage,
        nameof(AgentOptions.MaxNamedNotPrepared) => o => o.MaxNamedNotPrepared,
        _ => throw new InvalidOperationException("No reader for the editable setting " + name + "."),
    };

    /// <summary>The audit write of the last kill-switch flip failed; the switch keeps its state.</summary>
    private string? killSwitchError;

    private readonly Dictionary<string, string> drafts = new(StringComparer.Ordinal);
    private WalletResult<WalletSettings>? wallet;

    /// <summary>The wallet's own limits, read once through a fresh scope's client when the panel opens.</summary>
    protected override async Task OnInitializedAsync()
    {
        // Every open console follows a flip made in any of them (R4).
        Kill.Changed += OnKillSwitchChanged;
        await using var scope = Scopes.CreateAsyncScope();
        wallet = await scope.ServiceProvider.GetRequiredService<WalletClient>().GetSettingsAsync();
    }

    private static IEnumerable<(string Name, string Value)> WalletRows(WalletSettings s)
    {
        yield return ("Wallet:" + nameof(WalletSettings.PinRequiredAboveIqd), Number(s.PinRequiredAboveIqd));
        yield return ("Wallet:" + nameof(WalletSettings.MaxPinAttempts), Number(s.MaxPinAttempts));
        yield return ("Wallet:" + nameof(WalletSettings.TransferFeeIqd), Number(s.TransferFeeIqd));
        yield return ("Wallet:" + nameof(WalletSettings.BillFeeIqd), Number(s.BillFeeIqd));
        yield return ("Wallet:" + nameof(WalletSettings.PurchaseFeeIqd), Number(s.PurchaseFeeIqd));
    }

    private static string WalletUnavailable(WalletResult<WalletSettings> result) => result switch
    {
        WalletResult<WalletSettings>.Unavailable unavailable => "wallet unavailable: " + unavailable.Reason,
        WalletResult<WalletSettings>.Refused refused => "wallet unavailable: " + refused.Problem.Code,
        _ => "wallet unavailable",
    };
    private readonly Dictionary<string, string> errors = new(StringComparer.Ordinal);

    private static string Key(string name) => AgentOptions.SectionName + ":" + name;

    private string Draft(string name) => drafts.TryGetValue(name, out var draft) ? draft : string.Empty;

    private void Save(string name)
    {
        // Plain digits only (ASCII or Arabic-Indic, as the phone accepts); anything else is refused before the options see it.
        var typed = Agent.Core.Text.ArabicDigits.ToAscii(Draft(name).Trim());
        if (typed.Length == 0 || !typed.All(char.IsAsciiDigit))
        {
            errors[name] = name + ": type a whole number, digits only.";
            return;
        }

        if (Runtime.TrySet(Key(name), typed, out var error))
        {
            errors.Remove(name);
            drafts.Remove(name);
        }
        else
        {
            errors[name] = error;
        }
    }

    /// <summary>
    /// Flips the kill switch and writes one audit row for the flip, in a scope of its own. A failed write keeps the
    /// switch as set and shows an error line, so the circuit stays up (an exception here would end it).
    /// </summary>
    private async Task SetKillSwitchAsync(bool on)
    {
        Kill.Set(on);
        try
        {
            await using var scope = Scopes.CreateAsyncScope();
            await scope.ServiceProvider.GetRequiredService<AuditLog>().WriteAsync(
                Options.CurrentValue.DemoUserId, null, AuditEvents.KillSwitch, null, null, on ? "on" : "off", null, null, CancellationToken.None);
            killSwitchError = null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            killSwitchError = "The kill switch is " + (on ? "on" : "off") + ", but its audit row was not written (" + ex.GetType().Name + ").";
        }
    }

    private void OnKillSwitchChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Kill.Changed -= OnKillSwitchChanged;

    private void Reset(string name)
    {
        Runtime.Reset(Key(name));
        errors.Remove(name);
        drafts.Remove(name);
    }

    private static IEnumerable<(string Name, string Value)> ReadOnly(AgentOptions o)
    {
        yield return (nameof(AgentOptions.Parser), o.Parser);
        yield return (nameof(AgentOptions.DevSetPath), o.DevSetPath);
        yield return (nameof(AgentOptions.DemoUserId), Number(o.DemoUserId));
        yield return (nameof(AgentOptions.WalletBaseUrl), o.WalletBaseUrl?.ToString() ?? "-");
        yield return (nameof(AgentOptions.WalletTimeoutSeconds), Number(o.WalletTimeoutSeconds));
        yield return (nameof(AgentOptions.SettleWindowSeconds), Number(o.SettleWindowSeconds));
        yield return (nameof(AgentOptions.HistoryPageSize), Number(o.HistoryPageSize));
        yield return (nameof(AgentOptions.SweepIntervalSeconds), Number(o.SweepIntervalSeconds));
        yield return (nameof(AgentOptions.StaleExecutingAfterSeconds), Number(o.StaleExecutingAfterSeconds));
        // The spellings are phone text, so the console shows their count per biller, as the D6 words are counted.
        yield return (nameof(AgentOptions.ProviderSpellings), o.ProviderSpellings.Count == 0
            ? "none"
            : string.Join(", ", o.ProviderSpellings.OrderBy(p => p.Key, StringComparer.Ordinal).Select(p => p.Key + ": " + Number(p.Value.Count))));
        // Rule 1's endearments (Khalil, 17 Oct 2026) are phone text too, so only their count is shown.
        yield return (nameof(AgentOptions.Endearments), o.Endearments.Length == 0 ? "none" : Number(o.Endearments.Length));
        // The filler words dropped at either end of a typed answer (Khalil, 17 Oct 2026) are phone text: count only.
        yield return (nameof(AgentOptions.FillerWords), o.FillerWords.Length == 0 ? "none" : Number(o.FillerWords.Length));
    }

    /// <summary>The Model section: the candidate in use and each candidate's model, limits, prices and prompt cache lifetime.</summary>
    private IEnumerable<(string Name, string Value)> ModelRows()
    {
        var m = Model.Value;
        yield return ("Model:" + nameof(ModelOptions.Candidate), m.Candidate ?? "-");
        foreach (var (name, c) in m.Candidates.OrderBy(c => c.Key, StringComparer.Ordinal))
        {
            var prefix = "Model:" + name + ":";
            yield return (prefix + nameof(ModelCandidate.ModelId), c.Provider + " " + c.ModelId);
            yield return (prefix + nameof(ModelCandidate.MaxOutputTokens), Number(c.MaxOutputTokens));
            yield return (prefix + nameof(ModelCandidate.Effort), c.Effort);
            yield return (prefix + nameof(ModelCandidate.Temperature), c.Temperature?.ToString(CultureInfo.InvariantCulture) ?? "not sent");
            yield return (prefix + nameof(ModelCandidate.TimeoutSeconds), Number(c.TimeoutSeconds));
            yield return (prefix + "PricePerMTok",
                c.InputPricePerMTok.ToString(CultureInfo.InvariantCulture) + " in, "
                + c.OutputPricePerMTok.ToString(CultureInfo.InvariantCulture) + " out, "
                + c.CacheWritePricePerMTok.ToString(CultureInfo.InvariantCulture) + " cache write, "
                + c.CacheReadPricePerMTok.ToString(CultureInfo.InvariantCulture) + " cache read (USD)");
            yield return (prefix + nameof(ModelCandidate.PromptCacheTtl), c.PromptCacheTtl);
        }
    }

    private static string Number(long value) => PhoneFormat.Console(value);
}
