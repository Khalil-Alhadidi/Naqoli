@* A status as the wallet reports it, display only: an account's (UI pass task 5, decision 1) active in success on the
   success tint, closed in muted on the neutral tint; a payment's in the history (task 8) done in success, executing in
   warning, failed in danger, each on its tint. Any other value is muted on the neutral tint, so a value the wallet adds
   later still shows. Only active and closed carry an icon. The text is the value, lower case. *@
<span class="badge badge-@CssValue" data-testid="status-badge" data-status="@Value">
    @if (IconFor(CssValue) is { } icon)
    {
        <MudIcon Icon="@icon" Size="Size.Small" Class="badge-icon" />
    }
    @Value?.ToLowerInvariant()
</span>

@code {
    /// <summary>The status string, <c>active</c> or <c>closed</c> in the seed.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>
    /// Whether an account status is closed, by the agent's own constant (<see cref="Checks.ClosedStatus"/>): the panels
    /// mute such a row. Display only; the checks decide what a closed account may do.
    /// </summary>
    public static bool IsClosed(string? status) => string.Equals(status, Checks.ClosedStatus, StringComparison.OrdinalIgnoreCase);

    // The class suffix: the known values by name, anything else "other".
    private string CssValue => Value?.ToLowerInvariant() switch
    {
        "active" => "active",
        Checks.ClosedStatus => "closed",
        "done" => "done",
        "executing" => "executing",
        "failed" => "failed",
        _ => "other",
    };

    private static string? IconFor(string value) => value switch
    {
        "active" => Icons.Material.Filled.CheckCircle,
        Checks.ClosedStatus => Icons.Material.Filled.Block,
        _ => null,
    };
}
