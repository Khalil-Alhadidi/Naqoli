@implements IDisposable
@inject TraceLog Trace

@* The live trace (D17): every step of this circuit, newest first, coloured by zone. Codes, states and amounts only. *@
<MudPaper Class="pa-3 console-trace" Elevation="1">
    <div class="console-trace-head">
        <MudText Typo="Typo.h6">Live trace</MudText>
        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="Trace.Clear">Clear</MudButton>
    </div>
    <div class="console-trace-list">
        @foreach (var entry in Trace.Entries.Reverse())
        {
            <div class="trace-entry zone-@ZoneName(entry.Zone)" data-testid="trace-entry" data-zone="@ZoneName(entry.Zone)">
                <span class="trace-time">@entry.At.ToLocalTime().ToString("HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)</span>
                <span class="trace-zone">@entry.Zone</span>
                <span class="trace-step">@entry.Step</span>
                @if (entry.Detail is not null)
                {
                    <span class="trace-detail">@entry.Detail</span>
                }
            </div>
        }
    </div>
</MudPaper>

@code {
    protected override void OnInitialized() => Trace.Changed += OnChanged;

    public void Dispose() => Trace.Changed -= OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private static string ZoneName(TraceZone zone) => zone.ToString().ToLowerInvariant();
}
