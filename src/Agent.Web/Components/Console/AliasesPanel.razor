@implements IDisposable
@using Agent.Core.Aliases
@using Agent.Core.Wallet
@inject ChatSession Session
@inject WalletChanges WalletChanges
@inject IOptions<AgentOptions> Options
@inject IOptionsMonitor<ConsoleOptions> ConsoleSettings

@* The console's Aliases panel (milestone 9a, ruling 5), in English: the demo user's aliases as the wallet holds them, a
   delete per row, and a form to add one for a contact or a typed number. It acts through the circuit's ChatSession and
   the agent's AliasDirectory, as the phone's directory does; the agent does every check. It reloads on every
   WalletChanges notification for its user or for every user (any tab's phone or console, the reset); the session's
   Changed only re-renders the buttons while an action runs. The list shows one page of Console:GridPageSize rows, in the
   wallet's order, and keeps its page across a reload (clamped when a delete shrank it; UI pass, task 4b). *@
<MudPaper Class="pa-3" Elevation="1" data-testid="aliases-panel">
    <MudText Typo="Typo.h6">Aliases, user @Options.Value.DemoUserId</MudText>

    @if (contacts is WalletResult<WalletContacts>.Ok { Value: var directory })
    {
        var aliasRows = PagedList<WalletAlias>.Of(directory.Aliases, aliasesPage, PageSize);
        <MudSimpleTable Dense="true" Hover="true">
            <thead><tr><th>Alias</th><th>Phone</th><th>Registered name</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var alias in aliasRows.Rows)
                {
                    @* UI pass task 5 (decision 1, "keep both"): the account status as a badge; a closed account's row is muted. *@
                    <tr data-testid="console-alias" data-alias-id="@alias.AliasId" class="@(alias.AccountStatus == "closed" ? "row-muted" : null)">
                        <td><bdi>@alias.Text</bdi></td>
                        <td>@alias.Phone</td>
                        <td><bdi>@alias.RegisteredName</bdi></td>
                        <td><StatusBadge Value="@alias.AccountStatus" /></td>
                        <td>
                            <MudButton data-testid="console-alias-delete" data-alias-id="@alias.AliasId" Size="Size.Small"
                                       Variant="Variant.Text" Color="Color.Error" Disabled="@Session.Busy"
                                       OnClick="@(() => DeleteAsync(alias.AliasId))">Delete</MudButton>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
        <GridPager Grid="aliases" Total="@aliasRows.Total" Page="@aliasRows.Page" PageSize="@PageSize"
                   PageChanged="@((int page) => aliasesPage = page)" />
        @if (directory.Aliases.Count == 0)
        {
            <MudText Typo="Typo.body2">No aliases.</MudText>
        }
    }
    else if (contacts is WalletResult<WalletContacts>.Unavailable unavailable)
    {
        <MudText Color="Color.Error">wallet unavailable: @unavailable.Reason</MudText>
    }
    else if (contacts is WalletResult<WalletContacts>.Refused refused)
    {
        <MudText Color="Color.Error">wallet unavailable: @refused.Problem.Code</MudText>
    }

    <MudText Typo="Typo.subtitle1" Class="mt-3">Add an alias</MudText>
    <div class="console-alias-form">
        <input data-testid="console-alias-text" aria-label="Alias text" type="text" autocomplete="off" placeholder="Alias"
               @bind="aliasText" @bind:event="oninput" />
        <MudSelect T="int?" data-testid="console-alias-target" Label="Contact" Dense="true"
                   Value="target" ValueChanged="OnTargetChanged" ToStringFunc="TargetLabel">
            <MudSelectItem T="int?" Value="@((int?)null)">No contact (use the number)</MudSelectItem>
            @foreach (var contact in ContactList)
            {
                <MudSelectItem T="int?" Value="@contact.TargetAccountId" data-testid="console-alias-target-option" data-code="@contact.Code">
                    @contact.Code <bdi>@contact.SavedName</bdi> (<bdi>@contact.RegisteredName</bdi>)
                </MudSelectItem>
            }
        </MudSelect>
        @if (target is null)
        {
            <input data-testid="console-alias-phone" aria-label="Phone number" type="text" inputmode="tel" autocomplete="off"
                   placeholder="07XXXXXXXXX" @bind="phone" @bind:event="oninput" />
        }
        <MudButton data-testid="console-alias-save" Size="Size.Small" Variant="Variant.Outlined" Disabled="@(!CanSave)"
                   OnClick="SaveAsync">Save</MudButton>
    </div>
    @if (result is not null)
    {
        <MudText Typo="Typo.caption">Result: <span data-testid="console-alias-result" data-result="@result">@result</span></MudText>
    }
</MudPaper>

@code {
    private readonly CancellationTokenSource disposed = new();
    private WalletResult<WalletContacts>? contacts;
    private bool loading;
    private bool reloadRequested;
    private string aliasText = string.Empty;
    private string phone = string.Empty;
    private int? target;

    // The page shown, 1-based; kept across a reload, and clamped by PagedList.Of when the list shrank.
    private int aliasesPage = 1;

    /// <summary>Rows to a page: <c>Console:GridPageSize</c>, read on each render.</summary>
    private int PageSize => ConsoleSettings.CurrentValue.GridPageSize;

    // A code, never alias text: saved, deleted, the refusal's reason code, or unavailable.
    private string? result;

    private IEnumerable<WalletContact> ContactList
        => contacts is WalletResult<WalletContacts>.Ok { Value: var directory } ? directory.Contacts : [];

    private bool CanSave
        => !Session.Busy && !string.IsNullOrWhiteSpace(aliasText) && (target is not null || !string.IsNullOrWhiteSpace(phone));

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        WalletChanges.Changed += OnWalletChanged;
        await LoadAsync();
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        WalletChanges.Changed -= OnWalletChanged;
        disposed.Cancel();
        disposed.Dispose();
    }

    // The buttons follow Session.Busy; the list itself follows WalletChanges.
    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>Called on the raiser's thread (any circuit's): marshalled to this circuit with InvokeAsync.</summary>
    private void OnWalletChanged(WalletChange change)
    {
        if (change.Concerns(Options.Value.DemoUserId))
            _ = InvokeAsync(LoadAsync);
    }

    private async Task LoadAsync()
    {
        // A read queued before the component went away does nothing.
        if (disposed.IsCancellationRequested)
            return;

        // A read already running is followed by one more, so the last change is always shown.
        if (loading)
        {
            reloadRequested = true;
            return;
        }

        loading = true;
        try
        {
            do
            {
                reloadRequested = false;
                try
                {
                    contacts = await Session.ListAliasesAsync();
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    // Security review M1: a failed read shows the unavailable line with the exception's type, never its message.
                    contacts = new WalletResult<WalletContacts>.Unavailable(ex.GetType().Name);
                }
            }
            while (reloadRequested && !disposed.IsCancellationRequested);
        }
        finally
        {
            loading = false;
        }

        if (!disposed.IsCancellationRequested)
            StateHasChanged();
    }

    private void OnTargetChanged(int? value) => target = value;

    private string TargetLabel(int? value)
        => value is { } accountId
            ? ContactList.FirstOrDefault(c => c.TargetAccountId == accountId)?.Code ?? string.Empty
            : "No contact (use the number)";

    private async Task SaveAsync()
    {
        if (!CanSave)
            return;

        var saved = target is { } accountId
            ? await Session.AddAliasAsync(aliasText, accountId)
            : await Session.AddAliasForPhoneAsync(aliasText, phone);
        result = CodeOf(saved);
        if (saved is AliasResult.Saved)
        {
            aliasText = string.Empty;
            phone = string.Empty;
            target = null;
        }

        // A save raises an Alias change on WalletChanges; OnWalletChanged reloads the list (security review M5).
    }

    private async Task DeleteAsync(int aliasId) => result = CodeOf(await Session.DeleteAliasAsync(aliasId));

    private static string CodeOf(AliasResult? outcome) => outcome switch
    {
        AliasResult.Saved => "saved",
        AliasResult.Deleted => "deleted",
        AliasResult.Refused refused => refused.Code,
        _ => "unavailable",
    };
}
