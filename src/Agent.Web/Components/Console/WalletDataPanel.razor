@implements IDisposable
@using Agent.Core.Wallet
@inject IServiceScopeFactory Scopes
@inject WalletChanges WalletChanges
@inject IOptions<AgentOptions> Options
@inject IOptionsMonitor<ConsoleOptions> ConsoleSettings

@* Read only: the demo user's wallet as the mock wallet reports it. Each read goes through a fresh scope's client. It
   reloads on every WalletChanges notification for its user or for every user: a payment or an alias change from any
   tab's phone or console, the fault panel's external debit, the console's reset. Each grid shows one page of
   Console:GridPageSize rows (UI pass, task 4b): contacts and bills keep their page across a reload (clamped when the list
   shrank), and the history, read newest first, returns to page 1 on every reload so the newest payment is on screen. *@
<MudPaper Class="pa-3" Elevation="1">
    <MudText Typo="Typo.h6">Wallet data, user @userId</MudText>

    @* The bar on a reload; the first read shows skeleton rows in each grid instead. *@
    @if (loading && contacts is not null)
    {
        <MudProgressLinear Indeterminate="true" />
    }

    <MudText Typo="Typo.subtitle1" Class="mt-2">Balance</MudText>
    @if (balance is WalletResult<WalletBalance>.Ok { Value: var shown })
    {
        <MudText data-testid="wallet-balance" data-value="@shown.BalanceIqd">@PhoneFormat.Console(shown.BalanceIqd) IQD</MudText>
    }
    else if (balance is not null)
    {
        <MudText Color="Color.Error">@Unavailable(balance)</MudText>
    }

    @* UI pass task 8: before the first read a grid shows skeleton rows; an empty list shows its empty state; a table
       scrolls sideways inside its panel rather than squeezing its name columns. *@
    <MudText Typo="Typo.subtitle1" Class="mt-3">Contacts</MudText>
    @if (contacts is WalletResult<WalletContacts>.Ok { Value: var directory })
    {
        @if (directory.Contacts.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Filled.People" Text="No contacts yet." />
        }
        else
        {
            var contactRows = PagedList<WalletContact>.Of(directory.Contacts, contactsPage, PageSize);
            <div class="grid-scroll">
                <MudSimpleTable Dense="true" Hover="true">
                    <thead><tr><th>Code</th><th>Saved name</th><th>Registered name</th><th>Last sent</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var contact in contactRows.Rows)
                        {
                            @* UI pass task 5 (decision 1): the account status as a badge; a closed contact's row is muted. *@
                            <tr data-testid="wallet-contact-row" data-code="@contact.Code" class="@MutedWhenClosed(contact.AccountStatus)">
                                <td>@contact.Code</td>
                                <td class="cell-name"><bdi>@contact.SavedName</bdi></td>
                                <td class="cell-name"><bdi>@contact.RegisteredName</bdi></td>
                                <td class="cell-nowrap">@(contact.LastSentAmountIqd is { } last ? PhoneFormat.Console(last) + " IQD" : "-")</td>
                                <td><StatusBadge Value="@contact.AccountStatus" /></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
            <GridPager Grid="contacts" Total="@contactRows.Total" Page="@contactRows.Page" PageSize="@PageSize"
                       PageChanged="@((int page) => contactsPage = page)" />
        }
    }
    else if (contacts is not null)
    {
        <MudText Color="Color.Error">@Unavailable(contacts)</MudText>
    }
    else
    {
        <TableSkeleton />
    }

    <MudText Typo="Typo.subtitle1" Class="mt-3">Bills</MudText>
    @if (bills is WalletResult<IReadOnlyList<WalletBill>>.Ok { Value: var list })
    {
        @if (list.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Filled.Receipt" Text="No bills due." />
        }
        else
        {
            var billRows = PagedList<WalletBill>.Of(list, billsPage, PageSize);
            <div class="grid-scroll">
                <MudSimpleTable Dense="true" Hover="true">
                    <thead><tr><th>Code</th><th>Biller</th><th>Label</th><th>Due</th></tr></thead>
                    <tbody>
                        @foreach (var bill in billRows.Rows)
                        {
                            <tr>
                                <td>@bill.Code</td>
                                <td>@bill.BillerNameEn</td>
                                <td class="cell-name"><bdi>@bill.Label</bdi></td>
                                <td class="cell-nowrap">@PhoneFormat.Console(bill.AmountDueIqd) IQD</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
            <GridPager Grid="bills" Total="@billRows.Total" Page="@billRows.Page" PageSize="@PageSize"
                       PageChanged="@((int page) => billsPage = page)" />
        }
    }
    else if (bills is not null)
    {
        <MudText Color="Color.Error">@Unavailable(bills)</MudText>
    }
    else
    {
        <TableSkeleton />
    }

    <MudText Typo="Typo.subtitle1" Class="mt-3">History</MudText>
    @if (history is WalletResult<IReadOnlyList<WalletHistoryItem>>.Ok { Value: var rows })
    {
        @if (rows.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Filled.ReceiptLong" Text="No payments yet." />
        }
        else
        {
            var historyRows = PagedList<WalletHistoryItem>.Of(rows, historyPage, PageSize);
            <div class="grid-scroll">
                <MudSimpleTable Dense="true" Hover="true">
                    <thead><tr><th>Reference</th><th>Type</th><th>Status</th><th>Amount</th><th>Fee</th><th>To</th><th>When</th></tr></thead>
                    <tbody>
                        @foreach (var row in historyRows.Rows)
                        {
                            <tr data-testid="wallet-history-row" data-reference="@row.Reference">
                                <td class="cell-nowrap">@row.Reference</td>
                                <td>@row.Type</td>
                                <td><StatusBadge Value="@row.Status" /></td>
                                <td>@PhoneFormat.Console(row.AmountIqd)</td>
                                <td>@PhoneFormat.Console(row.FeeIqd)</td>
                                <td class="cell-name"><bdi>@row.CounterpartyName</bdi></td>
                                <td class="cell-nowrap">@row.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
            <GridPager Grid="history" Total="@historyRows.Total" Page="@historyRows.Page" PageSize="@PageSize"
                       PageChanged="@((int page) => historyPage = page)" />
        }
    }
    else if (history is not null)
    {
        <MudText Color="Color.Error">@Unavailable(history)</MudText>
    }
    else
    {
        <TableSkeleton />
    }
</MudPaper>

@code {
    private readonly CancellationTokenSource disposed = new();
    private int userId;
    private bool loading;
    private bool reloadRequested;
    private WalletResult<WalletBalance>? balance;
    private WalletResult<WalletContacts>? contacts;
    private WalletResult<IReadOnlyList<WalletBill>>? bills;
    private WalletResult<IReadOnlyList<WalletHistoryItem>>? history;

    // The page shown in each grid, 1-based. PagedList.Of clamps one that no longer exists.
    private int contactsPage = 1;
    private int billsPage = 1;
    private int historyPage = 1;

    /// <summary>Rows to a page in every grid: <c>Console:GridPageSize</c>, read on each render.</summary>
    private int PageSize => ConsoleSettings.CurrentValue.GridPageSize;

    protected override async Task OnInitializedAsync()
    {
        userId = Options.Value.DemoUserId;
        WalletChanges.Changed += OnWalletChanged;
        await LoadAsync();
    }

    public void Dispose()
    {
        WalletChanges.Changed -= OnWalletChanged;

        // A read still running when the component goes away is cancelled, not left to finish for nothing.
        disposed.Cancel();
        disposed.Dispose();
    }

    /// <summary>Called on the raiser's thread (any circuit's): marshalled to this circuit with InvokeAsync.</summary>
    private void OnWalletChanged(WalletChange change)
    {
        if (change.Concerns(userId))
            _ = InvokeAsync(LoadAsync);
    }

    private async Task LoadAsync()
    {
        // A read queued before the component went away does nothing.
        if (disposed.IsCancellationRequested)
            return;
        var token = disposed.Token;

        // A read already running is followed by one more, so the last change is always shown.
        if (loading)
        {
            reloadRequested = true;
            return;
        }

        loading = true;
        StateHasChanged();
        try
        {
            do
            {
                reloadRequested = false;
                await using var scope = Scopes.CreateAsyncScope();
                var wallet = scope.ServiceProvider.GetRequiredService<WalletClient>();
                balance = await wallet.GetBalanceAsync(userId, token);
                contacts = await wallet.GetContactsAsync(userId, token);
                bills = await wallet.GetBillsAsync(userId, token);
                // Agent:HistoryPageSize rows, newest first as the wallet returns them (decision 7); the grid pages them.
                history = await wallet.GetHistoryAsync(userId, since: null, toPhone: null, Options.Value.HistoryPageSize, token);

                // Every reload follows a wallet change (or the first open): the newest payment is the first row on screen.
                historyPage = 1;
            }
            while (reloadRequested);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // The component is gone: nothing to show.
            return;
        }
        finally
        {
            loading = false;
        }

        StateHasChanged();
    }

    private static string? MutedWhenClosed(string status) => status == "closed" ? "row-muted" : null;

    private static string Unavailable<T>(WalletResult<T> result) => result switch
    {
        WalletResult<T>.Unavailable unavailable => "wallet unavailable: " + unavailable.Reason,
        WalletResult<T>.Refused refused => "wallet unavailable: " + refused.Problem.Code,
        _ => string.Empty,
    };
}
