@implements IDisposable
@using Agent.Core.Wallet
@inject IServiceScopeFactory Scopes
@inject WalletChanges WalletChanges
@inject IOptions<AgentOptions> Options

@* Read only: the demo user's wallet as the mock wallet reports it. Each read goes through a fresh scope's client. It
   reloads on every WalletChanges notification for its user or for every user: a payment or an alias change from any
   tab's phone or console, the fault panel's external debit, the console's reset. *@
<MudPaper Class="pa-3" Elevation="1">
    <MudText Typo="Typo.h6">Wallet data, user @userId</MudText>

    @if (loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }

    <MudText Typo="Typo.subtitle1" Class="mt-2">Balance</MudText>
    @if (balance is WalletResult<WalletBalance>.Ok { Value: var shown })
    {
        <MudText data-testid="wallet-balance" data-value="@shown.BalanceIqd">@PhoneFormat.Console(shown.BalanceIqd) IQD</MudText>
    }
    else if (balance is not null)
    {
        <MudText Color="Color.Error">@Unavailable(balance)</MudText>
    }

    <MudText Typo="Typo.subtitle1" Class="mt-3">Contacts</MudText>
    @if (contacts is WalletResult<WalletContacts>.Ok { Value: var directory })
    {
        <MudSimpleTable Dense="true" Hover="true">
            <thead><tr><th>Code</th><th>Saved name</th><th>Registered name</th><th>Last sent</th></tr></thead>
            <tbody>
                @foreach (var contact in directory.Contacts)
                {
                    <tr>
                        <td>@contact.Code</td>
                        <td><bdi>@contact.SavedName</bdi></td>
                        <td><bdi>@contact.RegisteredName</bdi></td>
                        <td>@(contact.LastSentAmountIqd is { } last ? PhoneFormat.Console(last) + " IQD" : "-")</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
    else if (contacts is not null)
    {
        <MudText Color="Color.Error">@Unavailable(contacts)</MudText>
    }

    <MudText Typo="Typo.subtitle1" Class="mt-3">Bills</MudText>
    @if (bills is WalletResult<IReadOnlyList<WalletBill>>.Ok { Value: var list })
    {
        <MudSimpleTable Dense="true" Hover="true">
            <thead><tr><th>Code</th><th>Biller</th><th>Label</th><th>Due</th></tr></thead>
            <tbody>
                @foreach (var bill in list)
                {
                    <tr>
                        <td>@bill.Code</td>
                        <td>@bill.BillerNameEn</td>
                        <td><bdi>@bill.Label</bdi></td>
                        <td>@PhoneFormat.Console(bill.AmountDueIqd) IQD</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
    else if (bills is not null)
    {
        <MudText Color="Color.Error">@Unavailable(bills)</MudText>
    }

    <MudText Typo="Typo.subtitle1" Class="mt-3">History (last @HistoryRows)</MudText>
    @if (history is WalletResult<IReadOnlyList<WalletHistoryItem>>.Ok { Value: var rows })
    {
        <MudSimpleTable Dense="true" Hover="true">
            <thead><tr><th>Reference</th><th>Type</th><th>Status</th><th>Amount</th><th>Fee</th><th>To</th><th>When</th></tr></thead>
            <tbody>
                @foreach (var row in rows)
                {
                    <tr data-testid="wallet-history-row" data-reference="@row.Reference">
                        <td>@row.Reference</td>
                        <td>@row.Type</td>
                        <td>@row.Status</td>
                        <td>@PhoneFormat.Console(row.AmountIqd)</td>
                        <td>@PhoneFormat.Console(row.FeeIqd)</td>
                        <td><bdi>@row.CounterpartyName</bdi></td>
                        <td>@row.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
    else if (history is not null)
    {
        <MudText Color="Color.Error">@Unavailable(history)</MudText>
    }
</MudPaper>

@code {
    /// <summary>How many history rows the panel shows.</summary>
    private const int HistoryRows = 20;

    private readonly CancellationTokenSource disposed = new();
    private int userId;
    private bool loading;
    private bool reloadRequested;
    private WalletResult<WalletBalance>? balance;
    private WalletResult<WalletContacts>? contacts;
    private WalletResult<IReadOnlyList<WalletBill>>? bills;
    private WalletResult<IReadOnlyList<WalletHistoryItem>>? history;

    protected override async Task OnInitializedAsync()
    {
        userId = Options.Value.DemoUserId;
        WalletChanges.Changed += OnWalletChanged;
        await LoadAsync();
    }

    public void Dispose()
    {
        WalletChanges.Changed -= OnWalletChanged;

        // A read still running when the component goes away is cancelled, not left to finish for nothing.
        disposed.Cancel();
        disposed.Dispose();
    }

    /// <summary>Called on the raiser's thread (any circuit's): marshalled to this circuit with InvokeAsync.</summary>
    private void OnWalletChanged(WalletChange change)
    {
        if (change.Concerns(userId))
            _ = InvokeAsync(LoadAsync);
    }

    private async Task LoadAsync()
    {
        // A read queued before the component went away does nothing.
        if (disposed.IsCancellationRequested)
            return;
        var token = disposed.Token;

        // A read already running is followed by one more, so the last change is always shown.
        if (loading)
        {
            reloadRequested = true;
            return;
        }

        loading = true;
        StateHasChanged();
        try
        {
            do
            {
                reloadRequested = false;
                await using var scope = Scopes.CreateAsyncScope();
                var wallet = scope.ServiceProvider.GetRequiredService<WalletClient>();
                balance = await wallet.GetBalanceAsync(userId, token);
                contacts = await wallet.GetContactsAsync(userId, token);
                bills = await wallet.GetBillsAsync(userId, token);
                history = await wallet.GetHistoryAsync(userId, since: null, toPhone: null, HistoryRows, token);
            }
            while (reloadRequested);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // The component is gone: nothing to show.
            return;
        }
        finally
        {
            loading = false;
        }

        StateHasChanged();
    }

    private static string Unavailable<T>(WalletResult<T> result) => result switch
    {
        WalletResult<T>.Unavailable unavailable => "wallet unavailable: " + unavailable.Reason,
        WalletResult<T>.Refused refused => "wallet unavailable: " + refused.Problem.Code,
        _ => string.Empty,
    };
}
