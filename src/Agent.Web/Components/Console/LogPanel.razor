@implements IDisposable
@using System.Globalization
@using Agent.Core.Audit
@inject IServiceScopeFactory Scopes
@inject ChatSession Session
@inject WalletChanges WalletChanges
@inject IOptionsMonitor<AgentOptions> Options
@inject IOptionsMonitor<ConsoleOptions> ConsoleSettings

@* Read only: the latest audit rows, newest first. The rows hold no PIN, balance figure or purchase code, so none can be
   shown. Each read goes through a fresh scope's AuditLog. It reloads after each action of this circuit's session (the
   audit log is the agent's), and on every WalletChanges notification for its user or for every user (another tab's
   actions, the reset). It loads the latest Agent:LogPageSize rows and shows one page of Console:GridPageSize of them;
   every reload returns to page 1, so the newest row is on screen (UI pass, task 4b). *@
<MudPaper Class="pa-3" Elevation="1">
    <div class="d-flex align-center">
        <MudText Typo="Typo.h6">Log</MudText>
        <MudSpacer />
        <MudButton data-testid="log-refresh" Size="Size.Small" Variant="Variant.Outlined" Disabled="@loading"
                   OnClick="LoadAsync">Refresh</MudButton>
    </div>

    @if (loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }

    @if (failure is not null)
    {
        <MudText Color="Color.Error">@failure</MudText>
    }

    @{ var shown = PagedList<AuditEntry>.Of(rows, page, PageSize); }
    <MudSimpleTable Dense="true" Hover="true">
        <thead>
            <tr>
                <th>At (UTC)</th><th>User</th><th>Event</th><th>Pending</th><th>From → To</th><th>Reason</th>
                <th>Reference</th><th>Amount</th><th>Detail</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in shown.Rows)
            {
                var pending = ShortId(row.PendingId);
                <tr data-testid="log-row" data-event="@row.Event" data-reason="@(row.Reason ?? string.Empty)" data-pending="@pending">
                    <td>@row.At.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)</td>
                    <td>@row.UserId</td>
                    <td>@row.Event</td>
                    <td>@pending</td>
                    <td>@Transition(row)</td>
                    <td>@row.Reason</td>
                    <td>@row.Reference</td>
                    <td>@(row.AmountIqd is { } amount ? PhoneFormat.Console(amount) : string.Empty)</td>
                    <td>@row.Detail</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
    <GridPager Grid="log" Total="@shown.Total" Page="@shown.Page" PageSize="@PageSize"
               PageChanged="@((int next) => page = next)" />
</MudPaper>

@code {
    /// <summary>How many characters of a pending ID the table shows.</summary>
    private const int PendingIdChars = 8;

    private readonly CancellationTokenSource disposed = new();
    private IReadOnlyList<AuditEntry> rows = [];

    // The page shown, 1-based; every reload sets it back to 1.
    private int page = 1;
    private bool loading;
    private bool reloadRequested;
    private string? failure;

    /// <summary>Rows to a page: <c>Console:GridPageSize</c>, read on each render.</summary>
    private int PageSize => ConsoleSettings.CurrentValue.GridPageSize;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        WalletChanges.Changed += OnWalletChanged;
        await LoadAsync();
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        WalletChanges.Changed -= OnWalletChanged;

        // A read still running when the component goes away is cancelled, not left to finish for nothing.
        disposed.Cancel();
        disposed.Dispose();
    }

    private void OnSessionChanged()
    {
        // The session raises Changed many times during one action; read once it has finished.
        if (Session.Busy)
            return;
        _ = InvokeAsync(LoadAsync);
    }

    /// <summary>Called on the raiser's thread (any circuit's): marshalled to this circuit with InvokeAsync.</summary>
    private void OnWalletChanged(WalletChange change)
    {
        if (change.Concerns(Options.CurrentValue.DemoUserId))
            _ = InvokeAsync(LoadAsync);
    }

    private async Task LoadAsync()
    {
        // A read queued before the component went away does nothing.
        if (disposed.IsCancellationRequested)
            return;
        var token = disposed.Token;

        // A read already running is followed by one more, so the last action's rows are always shown.
        if (loading)
        {
            reloadRequested = true;
            return;
        }

        loading = true;
        StateHasChanged();
        try
        {
            do
            {
                reloadRequested = false;
                await using var scope = Scopes.CreateAsyncScope();
                rows = await scope.ServiceProvider.GetRequiredService<AuditLog>().ReadLatestAsync(Options.CurrentValue.LogPageSize, token);
                failure = null;

                // Each reload follows an action, a wallet change or Refresh: the newest row is the first on screen.
                page = 1;
            }
            while (reloadRequested);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // The component is gone: nothing to show.
            return;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            failure = "log unavailable: " + ex.GetType().Name;
        }
        finally
        {
            loading = false;
        }

        StateHasChanged();
    }

    private static string ShortId(Guid? id) => id is { } value ? value.ToString("N")[..PendingIdChars] : string.Empty;

    private static string Transition(AuditEntry row)
        => row.FromState is null && row.ToState is null ? string.Empty : $"{row.FromState ?? "-"} → {row.ToState ?? "-"}";
}
