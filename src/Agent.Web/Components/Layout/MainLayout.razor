@inherits LayoutComponentBase
@implements IDisposable
@inject ConsoleNavigation Navigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* Layout B (D17): side menu, the selected component in the middle, the live trace always visible, the phone on the
   right. Everything outside the phone frame is English, left to right. *@
<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6">ZainCash agent console</MudText>
    </MudAppBar>
    <MudDrawer @bind-Open="drawerOpen" Variant="DrawerVariant.Persistent" ClipMode="DrawerClipMode.Always" Elevation="1" Width="200px">
        <MudNavMenu>
            <MudNavLink data-testid="menu-wallet" Icon="@Icons.Material.Filled.AccountBalanceWallet"
                        Class="@ActiveClass(ConsolePanel.WalletData)" OnClick="@(() => Navigation.Select(ConsolePanel.WalletData))">Wallet data</MudNavLink>
            <MudNavLink data-testid="menu-settings" Icon="@Icons.Material.Filled.Settings"
                        Class="@ActiveClass(ConsolePanel.Settings)" OnClick="@(() => Navigation.Select(ConsolePanel.Settings))">Settings</MudNavLink>
            <MudNavLink data-testid="menu-log" Icon="@Icons.Material.Filled.ListAlt"
                        Class="@ActiveClass(ConsolePanel.Log)" OnClick="@(() => Navigation.Select(ConsolePanel.Log))">Log</MudNavLink>
            <MudNavLink data-testid="menu-learning" Icon="@Icons.Material.Filled.School"
                        Class="@ActiveClass(ConsolePanel.LearningData)" OnClick="@(() => Navigation.Select(ConsolePanel.LearningData))">Learning data</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    @* px and pb only: pa-3 would override the top padding that keeps the content below the fixed app bar. *@
    <MudMainContent Class="px-3 pb-3">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool drawerOpen = true;

    protected override void OnInitialized() => Navigation.Changed += OnNavigationChanged;

    public void Dispose() => Navigation.Changed -= OnNavigationChanged;

    private void ToggleDrawer() => drawerOpen = !drawerOpen;

    private void OnNavigationChanged() => _ = InvokeAsync(StateHasChanged);

    private string ActiveClass(ConsolePanel panel) => Navigation.Selected == panel ? "console-menu-active" : string.Empty;
}
