@inject IStringLocalizer<PhoneStrings> Text

@* The pager under the phone's two lists (UI pass task 4d, decision 3): right to left, chevrons only, their spoken labels
   from the resource file (rule 4), and between them the page and the page count in Arabic-Indic digits. It renders
   nothing when the whole list fits on one page; the list owns the page number, as GridPager's grids do. *@
@if (PageCount > 1)
{
    <div class="phone-pager" data-testid="phone-pager" data-page="@Page" data-pages="@PageCount">
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" aria-label="@Text["Pager_Previous"]"
                       data-testid="phone-pager-previous" Disabled="@(Page <= 1)" OnClick="() => GoTo(Page - 1)" />
        <span class="phone-pager-indicator" data-testid="phone-pager-indicator">@PhoneFormat.Number(Page) / @PhoneFormat.Number(PageCount)</span>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" aria-label="@Text["Pager_Next"]"
                       data-testid="phone-pager-next" Disabled="@(Page >= PageCount)" OnClick="() => GoTo(Page + 1)" />
    </div>
}

@code {
    /// <summary>The page shown, 1-based, as <see cref="PagedList{T}.Page"/> gives it (already clamped).</summary>
    [Parameter] public int Page { get; set; } = 1;

    /// <summary>How many pages the list has, as <see cref="PagedList{T}.PageCount"/> gives it.</summary>
    [Parameter, EditorRequired] public int PageCount { get; set; } = 1;

    /// <summary>Raised with the page asked for by the previous or next chevron.</summary>
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    private Task GoTo(int page) => page < 1 || page > PageCount ? Task.CompletedTask : PageChanged.InvokeAsync(page);
}
