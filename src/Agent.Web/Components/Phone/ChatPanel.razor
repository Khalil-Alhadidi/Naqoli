@inherits SessionComponent

<div class="phone-messages">
    @foreach (var message in Session.Messages)
    {
        <div class="phone-message @(message.Role == ChatRole.User ? "from-user" : "from-agent")"
             data-testid="chat-message" data-role="@RoleName(message)" data-kind="@KindName(message)">
            @if (message.Outcome is not null)
            {
                <span data-testid="outcome" data-outcome="@message.Outcome"><bdi>@message.Text</bdi></span>
            }
            else
            {
                <bdi>@message.Text</bdi>
            }

            @if (message.Action == ChatAction.CheckAgain && message.Id == Session.ActionMessageId && Session.CardState == CardStatus.Checking)
            {
                <div class="phone-message-action">
                    <MudButton data-testid="check-again" Variant="Variant.Outlined" Size="Size.Small" Disabled="@Session.Busy"
                               OnClick="CheckAgainAsync">@Text["Outcome_check_again"]</MudButton>
                </div>
            }
            @if (message.Action == ChatAction.SaveAlias && message.Id == Session.AliasOfferMessageId && Session.AliasOffer is not null)
            {
                @* Rule 18: the alias is saved only on this tap, never by words. *@
                <div class="phone-message-action">
                    <MudButton data-testid="save-alias" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               Disabled="@Session.Busy" OnClick="Session.SaveAliasAsync">@Text["Offer_save_alias_button"]</MudButton>
                </div>
            }
            @if (message.Action == ChatAction.CopyCode && message.CopyText is { } copyText)
            {
                @* Milestone 9b: the purchase code's copy button; the code is copied as the wallet gave it. *@
                <div class="phone-message-action">
                    <CopyButton Text="@copyText" TestId="purchase-code-copy" />
                </div>
            }
            @if (message.Action == ChatAction.Consent && message.Id == Session.ActionMessageId)
            {
                <div class="phone-message-action">
                    <MudButton data-testid="consent-button" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               Disabled="@Session.Busy" OnClick="Session.GiveConsentAsync">@Text["Reply_consent_button"]</MudButton>
                    @* Khalil, 20 Oct 2026: No sends nothing to the wallet; the buttons stay until Agree. *@
                    <MudButton data-testid="consent-decline" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               Disabled="@Session.Busy" OnClick="Session.DeclineConsentAsync">@Text["Reply_consent_decline_button"]</MudButton>
                </div>
            }
        </div>

        @if (message.Kind == ChatMessageKind.Card && message.Id == Session.CardMessageId && Session.Card is not null)
        {
            <CardPanel @key="Session.Card.PendingId" />
        }
        @if (message.Kind == ChatMessageKind.Question && message.Id == Session.QuestionMessageId && Session.Question is not null)
        {
            <QuestionPanel />
        }
    }
</div>

@code {
    private static string RoleName(ChatMessage message) => message.Role == ChatRole.User ? "user" : "agent";

    private static string KindName(ChatMessage message) => message.Kind switch
    {
        ChatMessageKind.Card => "card",
        ChatMessageKind.Question => "question",
        ChatMessageKind.Outcome => "outcome",
        _ => "text",
    };

    // The session, not the handler: the "check again" button reaches the Confirm handler only through it (rule 1).
    private Task CheckAgainAsync() => Session.SettleAsync();
}
