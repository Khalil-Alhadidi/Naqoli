@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IStringLocalizer<PhoneStrings> Strings

@* The copy button (milestone 9b): copies a purchase code through the browser's clipboard. The copied text is never
   logged or traced; on success the label reads Purchase_code_copied for two seconds, on failure Purchase_code_copy_failed
   for the same two seconds (security review R3). *@
<MudButton data-testid="@TestId" data-copied="@CopiedState" Variant="Variant.Outlined" Size="Size.Small"
           Disabled="@copying" OnClick="CopyAsync">@Label</MudButton>

@code {
    private static readonly TimeSpan CopiedFor = TimeSpan.FromSeconds(2);

    private readonly CancellationTokenSource disposing = new();
    // Security review M1: the import task is cached, not its result, so taps before the import resolves share one import.
    private Task<IJSObjectReference>? moduleTask;
    private bool copied;
    private bool failed;
    private bool copying;
    private bool disposed;
    private int copies;

    /// <summary>What to copy (the purchase code as the wallet gave it).</summary>
    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    /// <summary>The button's <c>data-testid</c>.</summary>
    [Parameter, EditorRequired]
    public string TestId { get; set; } = string.Empty;

    private string CopiedState => copied ? "true" : failed ? "failed" : "false";

    private string Label => Strings[copied ? "Purchase_code_copied" : failed ? "Purchase_code_copy_failed" : "Purchase_code_copy"];

    private async Task CopyAsync()
    {
        if (disposed || copying)
            return;

        // The button is disabled while a copy runs, which also closes the double-tap window.
        copying = true;
        bool ok;
        try
        {
            moduleTask ??= JS.InvokeAsync<IJSObjectReference>("import", disposing.Token, "./Components/Phone/CopyButton.razor.js").AsTask();
            var module = await moduleTask;
            ok = await module.InvokeAsync<bool>("copyText", disposing.Token, Text);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // The clipboard or the circuit failed: the label says so for two seconds. Nothing about the text is logged. A
            // failed import is not cached, so the next tap tries again.
            if (moduleTask is { IsFaulted: true } or { IsCanceled: true })
                moduleTask = null;
            ok = false;
        }
        finally
        {
            copying = false;
        }

        if (disposed)
            return;

        // The clipboard needs HTTPS or localhost and a user gesture; without them copyText returns false.
        copied = ok;
        failed = !ok;
        var copy = ++copies;
        StateHasChanged();
        try
        {
            await Task.Delay(CopiedFor, disposing.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        // A later copy restarts the two seconds; only the latest one reverts the label.
        if (copy == copies && !disposed)
        {
            copied = false;
            failed = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (disposed)
            return;

        // The flag first: a copy in flight sees it and does not touch the component again.
        disposed = true;
        await disposing.CancelAsync();
        if (moduleTask is { IsCompletedSuccessfully: true })
        {
            try
            {
                await (await moduleTask).DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone; the browser dropped the module with it.
            }
        }

        disposing.Dispose();
    }
}
