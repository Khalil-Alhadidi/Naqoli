@inherits SessionComponent

@* The phone (D20): right to left, Arabic, Arabic-Indic digits. Every text comes from the resource file (rule 4). *@
<MudRTLProvider RightToLeft="true">
    <div class="phone-frame" data-testid="phone-frame" dir="rtl" lang="ar" data-interactive="@(interactive ? "true" : "false")">
        <PhoneStatusBar />
        @* The header's buttons open the alias directory (milestone 9a) or My orders (milestone 9b) in place of the chat;
           Back returns to the chat. *@
        <div class="phone-header">
            @switch (screen)
            {
                case PhoneScreen.Directory:
                    <MudButton data-testid="phone-directory-back" Variant="Variant.Text" Size="Size.Small"
                               OnClick="@(() => screen = PhoneScreen.Chat)">@Text["Directory_Back"]</MudButton>
                    break;
                case PhoneScreen.Orders:
                    <MudButton data-testid="phone-orders-back" Variant="Variant.Text" Size="Size.Small"
                               OnClick="@(() => screen = PhoneScreen.Chat)">@Text["Directory_Back"]</MudButton>
                    break;
                default:
                    <MudButton data-testid="phone-directory" Variant="Variant.Text" Size="Size.Small"
                               OnClick="@(() => screen = PhoneScreen.Directory)">@Text["Directory_Open"]</MudButton>
                    <MudButton data-testid="phone-orders" Variant="Variant.Text" Size="Size.Small"
                               OnClick="@(() => screen = PhoneScreen.Orders)">@Text["Orders_Open"]</MudButton>
                    break;
            }
        </div>
        <div class="phone-screen" data-testid="phone-screen">
            @switch (screen)
            {
                case PhoneScreen.Directory:
                    <DirectoryPanel />
                    break;
                case PhoneScreen.Orders:
                    <OrdersPanel />
                    break;
                default:
                    <ChatPanel />
                    break;
            }
        </div>
        @* The compose row shows on the chat only, so nothing is typed into a chat that is not shown. *@
        @if (screen == PhoneScreen.Chat)
        {
        <div class="phone-compose">
            <input class="phone-input" data-testid="phone-input" type="text" autocomplete="off"
                   placeholder="@Text["Phone_Placeholder"]"
                   disabled="@Session.ConsentPending"
                   @bind="typed" @bind:event="oninput" @onkeydown="OnKeyDownAsync" />
            @* Khalil, 20 Oct 2026: nothing is typed while the consent screen's buttons show; Agree enables the box. *@
            <MudButton data-testid="phone-send" Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="@(Session.Busy || Session.ConsentPending || string.IsNullOrWhiteSpace(typed))" OnClick="SendAsync">
                @Text["Phone_Send"]
            </MudButton>
        </div>
        }
    </div>
</MudRTLProvider>

@code {
    private string typed = string.Empty;

    // What the phone shows: the chat, the alias directory (milestone 9a) or My orders (milestone 9b).
    private enum PhoneScreen
    {
        Chat,
        Directory,
        Orders,
    }

    private PhoneScreen screen = PhoneScreen.Chat;

    // True once the circuit is live (OnAfterRender runs only in the browser) and the open check has run, so the
    // journeys know input will land after it.
    private bool interactive;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // The consent screen before any typing (milestone 7 post-tag). Here, after the first interactive render: the page is
            // not prerendered, and the open check must write its audit row once per circuit.
            await Session.OpenAsync();
            interactive = true;
            StateHasChanged();
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendAsync();
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(typed) || Session.ConsentPending)
            return;

        var message = typed;
        typed = string.Empty;
        await Session.SendAsync(message);
    }
}
