@implements IDisposable
@inject TimeProvider Clock

@* The phone's status bar (UI pass task 7): the Iraq time in Arabic-Indic digits from the clock the session uses,
   refreshed every minute by a timer of that same clock, and three icons. It holds no string, so the phone's
   resource file is unchanged (rule 4). *@
<div class="phone-status-bar" data-testid="phone-status-bar">
    <span class="phone-status-time" dir="ltr">@PhoneFormat.Time(Clock.GetUtcNow())</span>
    <span class="phone-status-icons">
        <MudIcon Icon="@Icons.Material.Filled.SignalCellularAlt" Size="Size.Small" />
        <MudIcon Icon="@Icons.Material.Filled.Wifi" Size="Size.Small" />
        <MudIcon Icon="@Icons.Material.Filled.BatteryFull" Size="Size.Small" />
    </span>
</div>

@code {
    // From the same TimeProvider as the time shown, so a shifted or fake clock drives both (security review of the UI pass).
    private ITimer? timer;

    /// <summary>
    /// Set first in <see cref="Dispose"/>, read by the timer thread and the dispatcher: a tick already queued when the bar
    /// went away does nothing (the CardPanel pattern, review M2 of milestone 8).
    /// </summary>
    private volatile bool disposed;

    protected override void OnInitialized()
    {
        // The next tick lands on the next whole minute, then one a minute.
        var now = Clock.GetUtcNow();
        var toNextMinute = TimeSpan.FromMinutes(1) - TimeSpan.FromTicks(now.Ticks % TimeSpan.TicksPerMinute);
        timer = Clock.CreateTimer(_ =>
        {
            if (!disposed)
                _ = InvokeAsync(Refresh);
        }, null, toNextMinute, TimeSpan.FromMinutes(1));
    }

    private void Refresh()
    {
        if (!disposed)
            StateHasChanged();
    }

    public void Dispose()
    {
        // The flag first: a callback already running sees it and queues nothing, and a queued tick returns at once.
        disposed = true;
        timer?.Dispose();
    }
}
