@inherits SessionComponent
@inject IOptionsMonitor<AgentOptions> Options
@inject TraceLog Trace
@inject Agent.Core.Text.AmountWordParts Words

@* Every field comes from the CardView the session holds (rule 3); names from the wallet render inside bdi. *@
@if (Session.Card is { } card)
{
    <MudCard Class="phone-card" Elevation="2" data-testid="card" data-state="@StateName">
        <MudCardContent>
            <div class="phone-card-title">@Text["Card_Title"] <small>@Text["Type_" + card.Type]</small></div>
            <div class="phone-card-row">
                <span>@Text["Card_To"]</span>
                <span>
                    <span data-testid="card-display"><bdi>@PhoneFormat.Digits(card.DisplayName ?? string.Empty)</bdi></span>
                    @* A purchase's type word beside the operator (security review R4), only when its key exists. *@
                    @if (PhoneFormat.ProductTypeWord(card.ProductType, Text) is { } typeWord)
                    {
                        <span data-testid="card-product-type">@typeWord</span>
                    }
                </span>
            </div>
            @if (card.RegisteredName is not null)
            {
                <div class="phone-card-row">
                    <span>@Text["Card_Registered"]</span>
                    <span data-testid="card-registered"><bdi>@card.RegisteredName</bdi></span>
                </div>
            }
            <div class="phone-card-row">
                <span>@Text["Card_Amount"]</span>
                <span data-testid="card-amount">@PhoneFormat.Amount(card.AmountIqd, Text)</span>
            </div>
            @* The amount in words, a second guard under the figure: composed at render from the card's amount, never stored. *@
            @if (Agent.Core.Text.AmountWords.Compose(card.AmountIqd, Words) is { } words)
            {
                <div class="phone-card-words"><span data-testid="card-amount-words">@Text["Card_AmountWords", words]</span></div>
            }
            <div class="phone-card-row">
                <span>@Text["Card_Fee"]</span>
                <span data-testid="card-fee">@PhoneFormat.Amount(card.FeeIqd, Text)</span>
            </div>
            <div class="phone-card-row phone-card-total">
                <span>@Text["Card_Total"]</span>
                <span data-testid="card-total">@PhoneFormat.Amount(card.TotalIqd, Text)</span>
            </div>
            <div class="phone-card-row">
                <span>@Text["Card_BalanceAfter"]</span>
                <span data-testid="card-balance-after">@PhoneFormat.Amount(card.BalanceAfterIqd, Text)</span>
            </div>
            @if (card.FirstTime)
            {
                <div class="phone-card-note" data-testid="card-first-time">@Text["Card_FirstTime"]</div>
            }
            @if (card.Warning is not null)
            {
                <div class="phone-card-warning" data-testid="card-warning">@Text["Card_Warning_" + card.Warning]</div>
            }

            @if (IsLive)
            {
                <div class="phone-card-timer" data-testid="card-timer">@Text["Card_Timer", PhoneFormat.Number(remaining)]</div>
                <MudProgressLinear Value="@Progress" Color="@(remaining <= 10 ? Color.Warning : Color.Primary)" />
                @if (Session.PinVisible)
                {
                    <PinField Label="@Text["Card_Pin"]" @bind-Value="pin" />
                }
            }
            else if (Session.CardState == CardStatus.Expired || (Session.CardState == CardStatus.Live && remaining == 0))
            {
                <div class="phone-card-state">@Text["Card_Expired"]</div>
            }
            else if (Session.CardState == CardStatus.Cancelled)
            {
                <div class="phone-card-state">@Text["Card_Cancelled"]</div>
            }
            @* Rule 6: while Checking the card has no state line of its own (Khalil, 16 Oct 2026); the chat's
               Outcome_checking carries the message, and the card shows no countdown and never "failed". *@
        </MudCardContent>
        <MudCardActions>
            <MudButton data-testid="card-confirm" Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="@(!CanAct)" OnClick="ConfirmAsync">@Text["Card_Confirm"]</MudButton>
            <MudButton data-testid="card-cancel" Variant="Variant.Text"
                       Disabled="@(!CanAct)" OnClick="CancelAsync">@Text["Card_Cancel"]</MudButton>
            @if (IsChecking)
            {
                @* The same settle as the chat's "check again" (ChatSession.SettleAsync, same key); the tick also settles. *@
                <MudButton data-testid="card-check-again" Variant="Variant.Outlined" Color="Color.Primary"
                           Disabled="@(Session.Busy || acting)" OnClick="CheckAgainAsync">@Text["Outcome_check_again"]</MudButton>
            }
            @* D19: a new card from the stored request; never while the card is live or its payment is checking. *@
            @if (!IsLive && Session.Reissue == ReissueKind.TryAgain)
            {
                <MudButton data-testid="card-try-again" Variant="Variant.Outlined" Color="Color.Primary"
                           Disabled="@(!CanReissue)" OnClick="ReissueAsync">@Text["Card_TryAgain"]</MudButton>
            }
            else if (!IsLive && Session.Reissue == ReissueKind.SendAgain)
            {
                <MudButton data-testid="card-send-again" Variant="Variant.Outlined" Color="Color.Primary"
                           Disabled="@(!CanReissue)" OnClick="ReissueAsync">@Text["Card_SendAgain"]</MudButton>
            }
        </MudCardActions>
    </MudCard>
}

@code {
    private Timer? timer;

    /// <summary>
    /// Set first in <see cref="Dispose(bool)"/>, read by the timer thread and the dispatcher: a tick that was already
    /// queued when the panel went away does nothing, so no settle runs for a card the panel no longer shows (review M2).
    /// </summary>
    private volatile bool disposed;
    private int remaining;
    private int total = 1;
    private string? pin;
    private bool acting;
    private bool refreshRequested;

    /// <summary>When the card was first seen Checking, or last settled; null while it is not Checking.</summary>
    private DateTimeOffset? lastSettle;

    /// <summary>
    /// The id of the card this panel shows, captured once when it initialises (ruling 8 of milestone 9c). The chat panel
    /// keys the panel by the id, so a new card is a new panel; Confirm and Cancel name this id, so a tap on this card
    /// never reaches the next one.
    /// </summary>
    private Guid cardId;

    private bool IsLive => Session.CardState == CardStatus.Live && remaining > 0;

    private bool IsChecking => Session.CardState == CardStatus.Checking;

    private bool CanAct => IsLive && !Session.Busy && !acting;

    private bool CanReissue => !Session.Busy && !acting;

    private double Progress => total <= 0 ? 0 : 100.0 * remaining / total;

    private string StateName => Session.CardState?.ToString().ToLowerInvariant() ?? "none";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        cardId = Session.Card?.PendingId ?? Guid.Empty;
        Tick();
        total = Math.Max(1, remaining);

        // The countdown is a display tick; the timer itself is CardTimerSeconds, enforced by the store.
        timer = new Timer(_ =>
        {
            if (!disposed)
                _ = InvokeAsync(TickAsync);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void Tick()
    {
        remaining = Session.Card is { } card
            ? Math.Max(0, (int)Math.Ceiling((card.ExpiresAt - Session.Now).TotalSeconds))
            : 0;
    }

    private async Task TickAsync()
    {
        if (disposed)
            return;

        try
        {
            Tick();
            StateHasChanged();
            if (remaining == 0 && Session.CardState == CardStatus.Live && !refreshRequested)
            {
                // The timer has ended on screen: the session reads the record and marks the card expired.
                refreshRequested = true;
                await Session.RefreshAsync();
            }

            await SettleIfDueAsync();
        }
        catch (Exception ex)
        {
            // The tick's task is discarded by the timer, so a failure is traced here rather than left unobserved
            // (review M2); the type only, as every trace error is. The next tick tries again.
            Trace.Record(TraceZone.Code, "error", ex.GetType().Name);
        }
    }

    /// <summary>
    /// Ruling 5 of milestone 8: while the card is Checking, settle it by itself every <c>CheckingRetrySeconds</c> (read
    /// on each tick, so a saved value applies at once) through <see cref="ChatSession.SettleAsync"/>, the same method as
    /// the "check again" buttons, the same key. Never while the session is busy or a button is acting.
    /// </summary>
    private async Task SettleIfDueAsync()
    {
        if (!IsChecking)
        {
            lastSettle = null;
            return;
        }

        var now = Session.Now;
        if (lastSettle is not { } last)
        {
            lastSettle = now;
            return;
        }

        if (Session.Busy || acting || now - last < TimeSpan.FromSeconds(Options.CurrentValue.CheckingRetrySeconds))
            return;

        if (disposed)
            return;
        await SettleAsync();
    }

    private Task CheckAgainAsync() => SettleAsync();

    private async Task SettleAsync()
    {
        acting = true;
        try
        {
            await Session.SettleAsync();
        }
        finally
        {
            lastSettle = Session.Now;
            acting = false;
        }
    }

    private async Task ConfirmAsync()
    {
        // Disabled at once, before the first await renders, so a double tap sends one call from this card. The PIN is
        // handed to the call and cleared from the component.
        acting = true;
        var typedPin = pin;
        pin = null;
        try
        {
            await Session.ConfirmAsync(cardId, typedPin);
        }
        finally
        {
            acting = false;
        }
    }

    private async Task CancelAsync()
    {
        acting = true;
        try
        {
            await Session.CancelAsync(cardId);
        }
        finally
        {
            acting = false;
        }
    }

    private async Task ReissueAsync()
    {
        // Disabled at once, so a double tap opens one new card.
        acting = true;
        try
        {
            await Session.ReissueAsync();
        }
        finally
        {
            acting = false;
        }
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            // The flag first: a callback already running sees it and queues nothing, and a queued tick returns at once.
            disposed = true;
            timer?.Dispose();
        }
    }
}
