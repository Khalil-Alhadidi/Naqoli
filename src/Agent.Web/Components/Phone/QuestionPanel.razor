@inherits SessionComponent

@if (Session.Question is { } question)
{
    <div class="phone-options">
        @foreach (var option in question.Options)
        {
            <MudButton data-testid="question-option" data-value="@option.Value" Variant="Variant.Outlined" FullWidth="true"
                       Disabled="@Session.Busy" OnClick="@(() => Session.TapOptionAsync(option.Value))">
                <span class="phone-option">
                    <bdi>@Label(option)</bdi>
                    @if (option.RegisteredName is not null)
                    {
                        <small><bdi>@option.RegisteredName</bdi></small>
                    }
                    @if (IsContactOption(question.Kind, option))
                    {
                        <small data-testid="option-last-sent">@LastSent(option)</small>
                    }
                </span>
            </MudButton>
        }

        @* The final option of every question (17 Oct 2026): "none of these" on a contact question with options, "cancel"
           on every other one, typed questions included. Not one of the question's options. *@
        <MudButton data-testid="question-decline" data-value="@DeclineValue(question)" Variant="Variant.Text" FullWidth="true"
                   Disabled="@Session.Busy" OnClick="@Session.DeclineQuestionAsync">
            <bdi>@Text[DeclineValue(question) == Option.NoneOfThese ? "Option_NoneOfThese" : "Option_CancelQuestion"]</bdi>
        </MudButton>
    </div>
}

@code {
    // The options of a contact question label the last amount sent to that contact, or say there was none.
    private static bool IsContactQuestion(string kind)
        => kind is QuestionKinds.WhichContact or QuestionKinds.DidYouMean;

    // A contact option: every option of a contact question, and the person option of a person_or_bill question (Khalil,
    // 20 Oct 2026), which the panel labels by the option, not by the question kind.
    private static bool IsContactOption(string kind, Option option)
        => IsContactQuestion(kind) || option.Side == OptionSide.Person;

    private static string DeclineValue(AgentReply.Question question)
        => IsContactQuestion(question.Kind) && question.Options.Count > 0 ? Option.NoneOfThese : Option.CancelQuestion;

    private string LastSent(Option option)
        => option.LastSentAmountIqd is { } last
            ? Text["Option_LastSent", PhoneFormat.Amount(last, Text)]
            : Text["Option_NoPreviousTransfer"];

    private string Label(Option option) => PhoneFormat.OptionLabel(option, Text);
}
